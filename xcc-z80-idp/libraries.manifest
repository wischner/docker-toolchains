# Libraries installed for XCC (source/ref, installed archive, public headers)
retro-vault/libgpx v0.4.0 /opt/idp/lib/libgpx.a /opt/idp/include/libgpx.h
iskra-delta/idp-udev main-latest /opt/idp/lib/libugpx.a /opt/idp/include/ugpx.h
iskra-delta/idp-sdk main-latest /opt/idp/lib/libsdk.a /opt/idp/include/partner
retro-plastics/libsquid main-latest /opt/idp/lib/libsquid.a /opt/idp/include/squid

# idp-sdk and idp-udev's ugpx are built with XCC. idp-sdk's SDCC and
# libcpm3-z80 bundles and idp-udev's ulibc/usdcc libraries are intentionally
# excluded; XCC's native C and CP/M 3 runtimes are used instead.

# libsquid is the hand-written Z80 backend of the Squid serial wire protocol,
# built here by libsquid's own scripts/build-z80.sh against the cpm3 platform.
# It is a target library like the others; PAKET.COM does not link it, because
# PAKET compiles the same sources with a single socket of its own.
#
# PAKET.COM (iskra-delta/paket, main-latest) is a finished CP/M 3 program, not
# a library. It is installed under /opt/paket, together with a ready fddb.img
# floppy holding 0:PAKET.COM.
