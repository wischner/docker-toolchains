# Libraries installed for XCC (source/ref, installed archive, public headers)
retro-vault/libgpx v0.2.0 /opt/idp/lib/libgpx.a /opt/idp/include/libgpx.h
iskra-delta/idp-udev v1.0.1 /opt/idp/lib/libugpx.a /opt/idp/include/ugpx.h
iskra-delta/idp-sdk main-latest /opt/idp/lib/libsdk.a /opt/idp/include/partner

# idp-sdk and idp-udev's ugpx are built with XCC. idp-sdk's SDCC and
# libcpm3-z80 bundles and idp-udev's ulibc/usdcc libraries are intentionally
# excluded; XCC's native C and CP/M 3 runtimes are used instead.
