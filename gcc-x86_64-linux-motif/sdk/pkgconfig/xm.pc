prefix=/usr
exec_prefix=${prefix}
libdir=${prefix}/lib/x86_64-linux-gnu
includedir=${prefix}/include

Name: Open Motif Xm
Description: Open Motif widget toolkit
Version: 2.3.8
Requires: xt x11
Requires.private: xext xft xmu xrender fontconfig freetype2 libjpeg libpng zlib
Libs: -L${libdir} -lXm
Libs.private: -lm
Cflags: -I${includedir}
