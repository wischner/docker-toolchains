prefix=/usr
exec_prefix=${prefix}
libdir=${prefix}/lib/x86_64-linux-gnu
includedir=${prefix}/include

Name: Open Motif SDK (static)
Description: Complete Open Motif development stack using static Motif and GLw archives
Version: 2.3.8
Requires: uil-static mrm-static glw-static xm-static
Libs:
Cflags: -I${includedir}
