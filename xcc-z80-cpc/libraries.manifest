# Target libraries and startup files installed for XCC's Amstrad CPC work.
# Source refs are pinned to released tags; the exact commit for each is
# recorded under /opt/cpc/share/metadata in the image.
#
# libgpx's CPC backend is bare-metal: gpx_create() pages both ROMs out, so it
# cannot be linked against the firmware-hosted cpc-464/cpc-664/cpc-6128
# platforms. It ships with its own startup file and is kept off the default
# search path deliberately.
retro-vault/libgpx v1.0.0 /opt/cpc/lib/libgpx.a /opt/cpc/include/libgpx.h
retro-vault/libgpx v1.0.0 /opt/cpc/lib/crt0-cpc.rel -

# The firmware-hosted CPC runtimes (crt0-cpc-*.rel, libcpc-*.a, linker-cpc-*.ld)
# come from the X Compiler Suite in the base image and are already on XCC's
# normal search path.
