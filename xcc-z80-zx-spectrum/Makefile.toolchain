.PHONY: prepare build

BUILD_ARGS_FILE ?= build.args

prepare:
	@set -e; \
	base_image="$$(sed -n 's/^BASE_IMAGE=//p' "$(BUILD_ARGS_FILE)" | head -n1)"; \
	img_version="$$(sed -n 's/^IMG_VERSION=//p' "$(BUILD_ARGS_FILE)" | head -n1)"; \
	[ -n "$$img_version" ]; \
	[ "$$base_image" = "wischner/xcc-z80:$$img_version" ] || { \
	  echo "BASE_IMAGE must match IMG_VERSION" >&2; exit 1; \
	}; \
	for item in \
	  "retro-vault/libgpx LIBGPX_REF" \
	  "retro-plastics/libsquid LIBSQUID_REF" \
	  "retro-vault/beepolix BEEPOLIX_REF" \
	  "retro-vault/zx-spectrum-mcp ZX_SPECTRUM_MCP_REF" \
	  "retro-vault/snatch SNATCH_REF" \
	  "gasman/hdfmonkey HDFMONKEY_REF"; do \
	  set -- $$item; \
	  repo="$$1"; key="$$2"; \
	  ref="$$(sed -n "s/^$$key=//p" "$(BUILD_ARGS_FILE)" | head -n1)"; \
	  [ -n "$$ref" ]; \
	  echo "Checking $$repo#$$ref"; \
	  git ls-remote --exit-code "https://github.com/$$repo.git" \
	    "refs/heads/$$ref" "refs/tags/$$ref" "$$ref" | grep -q .; \
	done

build:
	@true
