.PHONY: prepare build

BUILD_ARGS_FILE ?= build.args
XYZ_REPO ?= retro-vault/xyz

prepare:
	@set -e; \
	img_version="$$(sed -n 's/^IMG_VERSION=//p' "$(BUILD_ARGS_FILE)" | head -n1)"; \
	xyz_version="$$(sed -n 's/^XYZ_VERSION=//p' "$(BUILD_ARGS_FILE)" | head -n1)"; \
	[ -n "$$img_version" ]; \
	[ "$$img_version" = "$$xyz_version" ] || { \
	  echo "IMG_VERSION and XYZ_VERSION must match" >&2; exit 1; \
	}; \
	tag="v$${xyz_version#v}"; \
	echo "Checking $(XYZ_REPO) $$tag"; \
	git ls-remote --exit-code --tags \
	  "https://github.com/$(XYZ_REPO).git" "refs/tags/$$tag" >/dev/null; \
	echo "Building X Compiler Suite $$xyz_version from source"

build:
	@true
